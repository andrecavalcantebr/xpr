{
    print("Hello" + " " + 'World');
    print("\n");
    print("linha\nnova");
    print("\n");
    print("aspas: \" e '");
    print("\n");
    print("barra: \\");
    print("\n");
    print(len("abc"));
    print("\n");
    print("a" == "a");
    print("\n");
    print("a" != "b");
    print("\n");
    print("abc" < "abd");
    print("\n");
}
