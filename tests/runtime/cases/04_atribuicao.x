/*
   FILE: 04_atribuicao.x
   DESC: Check chained assignments and assignment values.
   AUTHOR: Andre Cavalcante with Sonnet 5.5 partner
   DATE: October, 2026
   LICENSE: GPL-v3
*/

{
    a = 10;
    b = 20;
    c = a + b;
    print(c);
    print("\n");
    x = y = z = 5;
    print(x + y + z);
    print("\n");
    print(a = 99);
    print("\n");
    print(a);
    print("\n");
}
