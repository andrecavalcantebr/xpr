/*
   FILE: 03_booleanos.x
   DESC: Check boolean operators and their precedence.
   AUTHOR: Andre Cavalcante with Sonnet 5.5 partner
   DATE: October, 2026
   LICENSE: GPL-v3
*/

{
    print(true and false);
    print("\n");
    print(true or false);
    print("\n");
    print(not true);
    print("\n");
    print(not not true);
    print("\n");
    print(1 < 2 and 2 < 3);
    print("\n");
    print(true or false and false);
    print("\n");
    print(not false and true);
    print("\n");
}
