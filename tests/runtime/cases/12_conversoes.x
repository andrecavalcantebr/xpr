/*
   FILE: 12_conversoes.x
   DESC: Check numeric conversion and specified rounding rules.
   AUTHOR: Andre Cavalcante with Sonnet 5.5 partner
   DATE: October, 2026
   LICENSE: GPL-v3
*/

{
    print(int(3.7));
    print("\n");
    print(int(-3.7));
    print("\n");
    print(number("42.5"));
    print("\n");
    print(frac(-3.7));
    print("\n");
    print(floor(-3.7));
    print("\n");
    print(ceil(-3.7));
    print("\n");
    print(round(-3.7));
    print("\n");
}
