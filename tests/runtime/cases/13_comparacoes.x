/*
   FILE: 13_comparacoes.x
   DESC: Check supported comparisons and equality precedence.
   AUTHOR: Andre Cavalcante with Sonnet 5.5 partner
   DATE: October, 2026
   LICENSE: GPL-v3
*/

{
    print(1 < 2);
    print("\n");
    print(2 <= 2);
    print("\n");
    print(3 > 4);
    print("\n");
    print(4 >= 4);
    print("\n");
    print(5 == 5);
    print("\n");
    print(5 != 6);
    print("\n");
    print("a" == "a");
    print("\n");
    print(true == true);
    print("\n");
    print(true != false);
    print("\n");
    print(not 1 < 2);
    print("\n");
    print(false == 1 < 2);
    print("\n");
}
