/*
   FILE: 01_aritmetica.x
   DESC: Check arithmetic precedence and attached numeric signs.
   AUTHOR: Andre Cavalcante with Sonnet 5.5 partner
   DATE: October, 2026
   LICENSE: GPL-v3
*/

{
    print(2 + 3 * 4);
    print("\n");
    print((2 + 3) * 4);
    print("\n");
    print(10 / 4);
    print("\n");
    print(-5 + 3);
    print("\n");
    print(2 * -3);
    print("\n");
    print(+7);
    print("\n");
    print(1e2 + 0.5);
    print("\n");
    print(7 / 2);
    print("\n");
    print(-(2 + 3));
    print("\n");
}
